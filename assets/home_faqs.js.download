const initFAQ_accd=()=>{const faqHeaders=document.querySelectorAll(".kl360_faq_head");if(faqHeaders.length===0)return;faqHeaders.forEach((header)=>{header.addEventListener("click",function(){let content=this.nextElementSibling;let cross=this.querySelector(".kl360_faq_cross");document.querySelectorAll(".kl360_faq_head").forEach((otherHeader)=>{if(otherHeader!==this){otherHeader.classList.remove("active");let otherContent=otherHeader.nextElementSibling;let otherCross=otherHeader.querySelector(".kl360_faq_cross");otherCross?.classList.remove("active");if(otherContent){otherContent.style.maxHeight=null;otherContent.classList.remove("kl360_showHide")}}});this.classList.toggle("active");if(cross)cross.classList.toggle("active");content?.classList.toggle("kl360_showHide");if(content?.classList.contains("kl360_showHide")){content.style.maxHeight=content.scrollHeight+"px";if(window.innerWidth<=1024){setTimeout(()=>{const offset=116;const elementPosition=this.getBoundingClientRect().top+window.scrollY;window.scrollTo({top:elementPosition-offset,behavior:"smooth"})},1000)}}else{content.style.maxHeight=null}})})};document.addEventListener("DOMContentLoaded",()=>{initFAQ_accd()})
