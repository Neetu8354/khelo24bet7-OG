$('body').on('click', '.cancleBets', function () {
    $(this).attr('data-id');
    $('.CancelUnmatchedBets').attr('data-id', $(this).attr('data-id'));
    $('.cancel-unmatch').show();
    $('.openbets-pop').css('overflow', 'hidden');
});
$('body').on('click', '.close-button', function () {
    $('.cancel-unmatch').hide();
    $('.openbets-pop').css('overflow', 'auto');
});
$('body').on('click', '.CancelUnmatchedBets', function () {
    var id = {};
    id[0] = $(this).attr('data-id');
    $.ajax({
        type: 'post',
        url: '/ex/api/cancelAllBet',
        data: { 'id': id, '_token': $('meta[name="csrf-token"]').attr('content') },
        success: function (data) {
            notify(data.message, 'success');
            $('.close-button').click();
            $('.tab-button .unmatched').click();
        }
    });
});
$('body').on('keypress', '.coin_edit,#userCoin', function (evt) {
    var iKeyCode = (evt.which) ? evt.which : evt.keyCode
    if (iKeyCode != 46 && iKeyCode > 31 && (iKeyCode < 48 || iKeyCode > 57)) {
        return false;
    }
    return true;
});
$("body").on("keyup", "#userCoin,.coin_edit", function (e) {
    var err = 0;
    if (/\D/g.test($(this).val())) {
        $(this).val() = $(this).val().replace(/\D/g, "");
    }
    if ($(this).val() < 2000) {
        var err = 1;
        notify("minimum limit is 2000.");
    }
    if ($(this).val() > 1000000) {
        var err = 1;
        notify("maximum limit is 1000000.");
        $(this).val(1000000).blur();
        return false;
    }
    if (err == 1) {
        $("#settingSave, #goToEditStake").prop("disabled", true).addClass("disable");
    } else {
        $("#settingSave, #goToEditStake").prop("disabled", false).removeClass("disable");
    }
});
$("body").on("keyup change", ".settingEditNum", function () {
    if (/\D/g.test(this.value)) {
        this.value = this.value.replace(/\D/g, "");
    }
    var err = 0;
    if ($(this).val() == "") {
        notify("Edited fields can`t be empty.");
        err = 1;
    }
    if ($(this).val() < 2000) {
        notify('minimum limit is 2000.', 'danger', 800);
        err = 1;
    }
    if ($(this).val() > 1000000) {
        err = 1;
        notify('minimum limit is 1000000.', 'danger', 800);
        $(this).val($(this).val().slice(0, -1));
    }
    if (err == 1) {
        $("#goToEditStake").prop("disabled", true).addClass("disable");
    } else {
        $("#goToEditStake").prop("disabled", false).removeClass("disable");
    }
});
$('body').on('click', '#goToEditStake', function () {
    var coinValue = [];
    $.each($('.coin_edit'), function (k, v) {

        if (!$(v).val()) {
            return false;
        }
        if ($(v).val() == '') {
            notify('Edited fields can`t be empty.');
            return false;
        }
        if ($(v).val() < 2000) {
            notify('minimum limit is 2000.', 'danger', 800);
            return false;
        }

        if ($(v).val() > 1000000) {
            notify('minimum limit is 1000000.', 'danger', 800);
            $(v).val($(v).val().slice(0, -1));
            return false;
        }

        const value = parseFloat($(v).val());
        coinValue.push(value);

        const isUnique = coinValue.length === new Set(coinValue).size;

        if (!isUnique) {
            notify('Amount should be unique.', 'danger', 800);
            $('.stakes-input').show();
            $('.edit-stakes').hide();
            $('.stakes-multiselect').hide();
            return false;
        } else {
            $('.stakes-input').hide();
            $('.edit-stakes').show();
            $('.stakes-multiselect').show();
        }
    })
    $.each(coinValue.sort(sortmyway), function (k, v) {
        $('.coins:eq(' + k + ')').html(v)
    })
})
$('body').on('click', '.submit-stakes', function () {
    $('.stakes-multiselect').show()
    $('.stakes-input').hide()
    var statkeval = $('.stakes-input input').val()
})
$('body').on('click', '.edit-stakes', function () {
    $(this).hide();
    $('.stakes-multiselect').hide();
    $.each($('.coins'), function (k, v) {
        $('#' + $(v).data('id')).val($(v).html())
    })
    $('.stakes-input').show();
})
function sortmyway(data_A, data_B) {
    return (data_A - data_B);
}
function validateInput(input) {
    let value = input.value.toString();
    let valuezero = value.charAt(0);

    if (valuezero === '0') {
        input.value = '';
        return;
    }

    if (value.charAt(5) === '.' || value.charAt(6) === '.') {
        input.value = value.slice(0, 5 + (value.charAt(6) === '.' ? 1 : 0));
        return;
    }
    if ((value.match(/\./g) || []).length > 1) {
        const firstDotIndex = value.indexOf('.');
        input.value = value.slice(0, firstDotIndex + 1) + value.slice(firstDotIndex + 1).replace(/\./g, '');
        return;
    }

    let numericValue = parseInt(value);
    if (numericValue > 1000000) {
        input.value = '1000000';
        notify("Maximum amount is 10 lakhs")
    } else {
        input.value = value;
    }

    let dotIndex = value.indexOf('.');
    if (dotIndex !== -1) {
        let integerPart = value.slice(0, dotIndex);
        let decimalPart = value.slice(dotIndex + 1);
        if (decimalPart.length > 2) {
            input.value = `${integerPart}.${decimalPart.slice(0, 2)}`;
        }
    }
}

// To prevent drag events on anchor tags
let getAllAnchorTags = document.querySelectorAll("a");
let preventDragEvent = function (event) {
    event.preventDefault()
};
getAllAnchorTags.forEach(function (link) {
    link.addEventListener("dragstart", preventDragEvent);
})

