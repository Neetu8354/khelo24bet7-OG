var isMobile = false;
if ((navigator.userAgent.match(/iPhone/i)) || (navigator.userAgent.match(/iPod/i)) || (navigator.userAgent.match(/iPad/i)) || (navigator.userAgent.match(/Android/i)) || (navigator.userAgent.match(/Blackberry/i)) || (navigator.userAgent.match(/Windows Phone/i))) {
    isMobile = true;
    $(".v-marquee").on("mouseenter", (function () { $(this).children(".running").addClass("running") }));
    $(".v-marquee").on("mouseleave", (function () { $(this).children(".running").addClass("running") }));
    setTimeout(() => {
        $('.v-marquee').addClass('mobile__marquee');
    }, 2000);

    $('body').on('click', '.v-marquee', function () {
        $(this).toggleClass('pause__marquee');
    });
} else {
    $(".v-marquee").on("mouseenter", (function () { $(this).children(".running").removeClass("running").addClass("pause") })), $(".v-marquee").on("mouseleave", (function () { $(this).children(".pause").removeClass("pause").addClass("running") }))
    $('.v-marquee').removeClass('mobile__marquee');
    $('body').on('click', '.v-marquee', function () {
        $(this).removeClass('pause__marquee');
    });
}
