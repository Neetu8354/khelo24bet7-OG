$(".accountPageTab a").on("click", function () {
    var dataIdValue = $(this).data("id");
    if (dataIdValue === "promotionHistory") {
        $('.hr_homeWidgetWrapper_txt').text("PROMOTION HISTORY");
    } else if (dataIdValue === "rewardCashback") {
        $('.hr_homeWidgetWrapper_txt').text("REWARD");
    }
    else if (dataIdValue === "mybonus") {
        $('.hr_homeWidgetWrapper_txt').text("MY BONUS");
    } else if (dataIdValue === "myreferral") {
        $('.hr_homeWidgetWrapper_txt').text("MY REFERRAL");
    }
    else if (dataIdValue === "systemMsg") {
        $('.hr_homeWidgetWrapper_txt').text("SYSTEM BULLETIN");
    } else if (dataIdValue === "eventMsg") {
        $('.hr_homeWidgetWrapper_txt').text("EVENT ANNOUNCEMENT");
    } else if (dataIdValue === "personalMsg") {
        $('.hr_homeWidgetWrapper_txt').text("PERSONAL MESSAGE");
    }
    else if (dataIdValue === "userProfileDiv") {
        $('.hr_homeWidgetWrapper_txt').text("PROFILE");
    } else if (dataIdValue === "profileBankDiv") {
        $('.hr_homeWidgetWrapper_txt').text("BANK DETAILS");
    }
});

