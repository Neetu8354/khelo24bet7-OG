    scrollToCenter();
}, 500);

function scrollToCenter() {
    var pathname = window.location.pathname;
    if ($(".MobToolbar").length === 1) {
        if (pathname.includes('/live-casino')) {
            let activeItem = $(".MobToolbar li.actives");
            $(".navbar-scroll").scrollLeft($(".navbar-scroll").prop("scrollWidth")).width();
            var e = activeItem.offset().left - $(".navbar-scroll").width() / 2;
            $(".navbar-scroll").scrollLeft($(".navbar-scroll").scrollLeft() + e);
        }
    }
}

