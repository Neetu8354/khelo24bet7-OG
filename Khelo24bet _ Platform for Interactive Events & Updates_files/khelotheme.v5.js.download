$('#withdraw_account_name').on('input', function () {
    var inputValue = $(this).val();
    var alphabeticRegex = /^[a-zA-Z\s]+$/; // Allow spaces (\s)
    if (!alphabeticRegex.test(inputValue)) {
        $(this).val(inputValue.replace(/[^a-zA-Z\s]/g, ''));
    }
});

