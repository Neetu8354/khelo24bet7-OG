var scrollToTopBtn = $("#scroll_top");

$("body").on("click", ".show_scrl", function (event) {
    event.preventDefault();
    $("html, body").animate({ scrollTop: 0 }, 500);
});

$(window).scroll(function () {
    if ($(window).scrollTop() > 500) {
        scrollToTopBtn.addClass("show_scrl");
    } else {
        scrollToTopBtn.removeClass("show_scrl");
    }
});

function initializeSwiper(selector, options) {
    const swiperContainer = document.querySelector(selector);
    if (swiperContainer) {
        new Swiper(swiperContainer, options);
    }
}

