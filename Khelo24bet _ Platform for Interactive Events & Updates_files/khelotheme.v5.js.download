$(window).on("load", function () {
    if ($("#home_popup").is(":visible") || $("#vip_popup").is(":visible") || $("#cashBack_before_deposit_popup_id").is(":visible")) {
        $("body, html").addClass("modal-open");
    }

    var pathname = window.location.pathname;
    if (pathname.includes('/ex/d/inplay')) {
        $('.sports_wrap_slider li').find('span').removeClass('active_border');
        $('.sports_wrap_slider li.in--play').addClass('active');
        $('.sports_wrap_slider li.in--play').find('span').addClass('active_border');
    }

    $(".sportsbook_page_skeleton").hide()
});
$('body').on('click', '.vip__top__arrow', function () {
    $("#vip_popup .spinWinInfo").animate({ scrollTop: $('#vip_popup .spinWinInfo').height() }, 1000);
    $('.vip__down__arrow').hide();
    $(this).hide();
});
$('#vip_popup .spinWinInfo').on('scroll', function () {
    var scrollTop = $(this).scrollTop();
    if (scrollTop + $(this).innerHeight() >= this.scrollHeight) {
        $('.vip__top__arrow').hide();
    } else if (scrollTop <= 0) {
        $('.vip__top__arrow').show();
    }
});
